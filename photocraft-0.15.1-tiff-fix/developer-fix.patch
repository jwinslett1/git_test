+#[test]
+fn cmyk_spot_preserves_four_inks_alpha_and_spot_at_all_depths() {
+    for layout in [ChannelLayout::Cmyk, ChannelLayout::CmykA] {
+        for sample in [SampleType::U8, SampleType::U16, SampleType::F32] {
+            for compression in [TiffCompression::None, TiffCompression::Lzw, TiffCompression::Deflate, TiffCompression::PackBits] {
+                let mut pixels = Vec::new();
+                let mut spot = Vec::new();
+                for i in 0..3 {
+                    for c in 0..layout.channels() {
+                        let value = if c == 4 { i as f32 / 2.0 } else { (i + c) as f32 / 6.0 };
+                        match sample {
+                            SampleType::U8 => pixels.push((value * 255.0).round() as u8),
+                            SampleType::U16 => pixels.extend_from_slice(&((value * 65535.0).round() as u16).to_ne_bytes()),
+                            SampleType::F32 => pixels.extend_from_slice(&value.to_ne_bytes()),
+                            _ => unreachable!(),
+                        }
+                    }
+                    let value = 1.0 - i as f32 / 2.0;
+                    match sample {
+                        SampleType::U8 => spot.push((value * 255.0).round() as u8),
+                        SampleType::U16 => spot.extend_from_slice(&((value * 65535.0).round() as u16).to_ne_bytes()),
+                        SampleType::F32 => spot.extend_from_slice(&value.to_ne_bytes()),
+                        _ => unreachable!(),
+                    }
+                }
+                let image = Image::from_raw(3, 1, layout, sample, pixels.clone()).unwrap();
+                let options = EncodeOptions { tiff_compression: compression, ..Default::default() };
+                let bytes = photocraft_codecs::encode_tiff_spot(&image, &spot, &options).unwrap();
+                let mut raw = Decoder::new(Cursor::new(&bytes)).unwrap();
+                assert_eq!(raw.get_tag_u32(Tag::PhotometricInterpretation).unwrap(), 5);
+                assert_eq!(raw.get_tag_u32(Tag::SamplesPerPixel).unwrap(), if layout.has_alpha() { 6 } else { 5 });
+                assert_eq!(raw.get_tag_u16_vec(Tag::ExtraSamples).unwrap(), if layout.has_alpha() { vec![2, 0] } else { vec![0] });
+                let decoded = photocraft_codecs::decode(&bytes).unwrap();
+                assert_eq!(decoded.layout(), layout);
+                assert_eq!(decoded.data(), pixels);
+                assert_eq!(decoded.meta.tiff_extra_samples, vec![spot]);
+            }
+        }
+    }
+}
