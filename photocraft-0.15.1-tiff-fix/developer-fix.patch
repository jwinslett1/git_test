+#[test]
+fn cmyk_transparency_and_white_spot_roundtrip_all_depths() {
+    for depth in [SampleType::U8, SampleType::U16, SampleType::F32] {
+        for transparent in [false, true] {
+            let mut doc = Document::new("CMYK DTF", Size::new(3, 1), ColorMode::Cmyk, depth);
+            let mut art = Surface::new(doc.pixel_format());
+            art.write_region(
+                doc.bounds(),
+                &[0., 1., 1., 0., 1., 1., 0., 1., 0., if transparent { 0.5 } else { 1. }, 1., 1., 0., 0., if transparent { 0. } else { 1. }],
+            );
+            doc.layers.push(Layer::new("CMYK artwork", LayerContent::Raster(art)));
+            doc.channels = document(depth, transparent).channels;
+            for layered in [false, true] {
+                let output = export(&doc, "cmyk.tif", &ExportOptions { tiff_layers: layered, ..Default::default() }).unwrap();
+                assert!(output.warnings.is_empty(), "{:?}", output.warnings);
+                let decoded = photocraft_codecs::decode(&output.bytes).unwrap();
+                assert!(decoded.layout().is_cmyk());
+                assert_eq!(decoded.layout().has_alpha(), transparent);
+                assert_eq!(decoded.meta.tiff_extra_samples.len(), 1);
+                let back = import("cmyk.tif", &output.bytes).unwrap();
+                assert!(back.warnings.is_empty(), "{:?}", back.warnings);
+                assert_eq!(back.document.mode, ColorMode::Cmyk);
+                assert_spot(&doc, &back.document);
+                let psd = export(&doc, "cmyk.psd", &Default::default()).unwrap();
+                let psd_back = import("cmyk.psd", &psd.bytes).unwrap();
+                assert_spot(&doc, &psd_back.document);
+                if layered {
+                    assert_eq!(raster(&back.document), raster(&psd_back.document));
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn legacy_pascal_channel_names_keep_transparency_and_spot_aligned() {
+    let doc = document(SampleType::U8, true);
+    let mut output = export(&doc, "legacy.tif", &ExportOptions { tiff_layers: false, ..Default::default() }).unwrap();
+    // Hide the Unicode-name resource; the Pascal-name resource remains intact.
+    let marker = [b'8', b'B', b'I', b'M', 4, 21]; // 1045
+    let at = output.bytes.windows(marker.len()).position(|b| b == marker).unwrap();
+    output.bytes[at + 4..at + 6].copy_from_slice(&60000u16.to_be_bytes());
+    let back = import("legacy.tif", &output.bytes).unwrap();
+    assert_spot(&doc, &back.document);
+}
+
+#[test]
+fn adding_a_spot_does_not_reseparate_a_plain_cmyk_layer() {
+    for depth in [SampleType::U8, SampleType::U16, SampleType::F32] {
+        let mut doc = Document::new("preserve inks", Size::new(3, 1), ColorMode::Cmyk, depth);
+        let mut art = Surface::new(doc.pixel_format());
+        art.write_region(doc.bounds(), &[0.1, 0.6, 0.9, 0., 1., 0.2, 0.7, 0.9, 0.3, 0.5, 0.4, 0.2, 0.1, 0.8, 0.25]);
+        let expected = art.to_interleaved(doc.bounds());
+        doc.layers.push(Layer::new("native CMYK inks", LayerContent::Raster(art)));
+        doc.channels = document(depth, true).channels;
+        for layered in [false, true] {
+            let output = export(&doc, "inks.tif", &ExportOptions { tiff_layers: layered, ..Default::default() }).unwrap();
+            let decoded = photocraft_codecs::decode(&output.bytes).unwrap();
+            assert_eq!(decoded.data(), expected);
+            let back = import("inks.tif", &output.bytes).unwrap();
+            assert_spot(&doc, &back.document);
+            let restored = raster(&back.document);
+            if depth == SampleType::F32 {
+                // Layered import passes through PSD's 1 - CMYK convention;
+                // subtracting twice can round by a float ULP. File pixels above
+                // must still match the original native samples byte-for-byte.
+                for (a, b) in restored.as_chunks::<4>().0.iter().zip(expected.as_chunks::<4>().0) {
+                    assert!((f32::from_ne_bytes(*a) - f32::from_ne_bytes(*b)).abs() <= f32::EPSILON);
+                }
+            } else {
+                assert_eq!(restored, expected);
+            }
+        }
+    }
+}
